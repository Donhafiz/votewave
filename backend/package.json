{
  "name": "votewave-backend",
  "version": "2.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "type": "commonjs",
    "test": "mocha test/**/*.test.js --timeout 10000",
    "test:ts": "mocha test/**/*.test.ts --require ts-node/register --timeout 10000",
    "test:watch": "mocha test/**/*.test.js --watch --timeout 10000",
    "test:coverage": "nyc mocha test/**/*.test.js --timeout 10000",
    "worker:vote": "node dist/workers/vote.worker.js",
    "worker:email": "node dist/workers/email.worker.js",
    "worker:analytics": "node dist/workers/analytics.worker.js",
    "worker:erie": "node dist/core/erie/erie.router.js",
    "worker:ml": "node dist/ml/ml.worker.js",
    "worker:fraud": "node dist/security/fraud/fraud.worker.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "redis": "^5.12.1",
    "socket.io": "^4.7.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "nyc": "^15.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ],
    "transpileOnly": true
  }
}
